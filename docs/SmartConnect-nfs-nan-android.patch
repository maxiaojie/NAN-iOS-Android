@@ -0,0 +1,35 @@
+package com.lenovo.hec.lenovoextend.nfsclientlib
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class NfsServerAddressTest {
+    @Test fun scopedIpv6DoesNotBecomeFe80Hostname() {
+        val host = "fe80::1234:5678%aware_data0"
+        val value = NfsServerAddress.format(host, "/root")
+        assertEquals("[$host]:/root", value)
+        assertEquals(host, NfsServerAddress.host(value))
+        assertEquals("/root", NfsServerAddress.exportPath(value))
+    }
+
+    @Test fun ipv4KeysRemainCompatible() {
+        val value = NfsServerAddress.format("192.168.31.2", "/sdcard")
+        assertEquals("192.168.31.2:/sdcard", value)
+        assertEquals("192.168.31.2", NfsServerAddress.host(value))
+    }
+
+    @Test fun legacyIpv6AndColonsInFileNamesArePreserved() {
+        val value = "fe80::1234%aware_data0:/root/a:b"
+        assertEquals("fe80::1234%aware_data0", NfsServerAddress.host(value))
+        assertEquals("/root/a:b", NfsServerAddress.exportPath(value))
+    }
+
+    @Test fun deviceDocumentIdsKeepTheirExportPath() {
+        assertEquals("/root/a:b", NfsServerAddress.exportPath("device-id:/root/a:b"))
+    }
+
+    @Test(expected = IllegalArgumentException::class)
+    fun malformedBracketedHostIsRejected() {
+        NfsServerAddress.host("[fe80::1:/root")
+    }
+}
