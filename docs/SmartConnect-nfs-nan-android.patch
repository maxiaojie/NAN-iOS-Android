@@ -0,0 +1,32 @@
+package com.lenovo.hec.lenovoextend.nfsclientlib
+
+/** Keeps a scoped IPv6 host separate from the exported filesystem path. */
+object NfsServerAddress {
+    fun format(host: String?, path: String?): String {
+        val address = host.orEmpty().removePrefix("[").removeSuffix("]")
+        return (if (address.contains(':')) "[$address]" else address) + ":" + path.orEmpty()
+    }
+
+    private fun separator(value: String): Int {
+        if (value.startsWith('[')) {
+            val end = value.indexOf("]:")
+            require(end > 0) { "Invalid bracketed NFS address" }
+            return end + 1
+        }
+        // Accept old unbracketed IPv6 mount keys whose export is an absolute path.
+        val absolutePath = value.indexOf(":/")
+        return if (absolutePath >= 0) absolutePath else value.indexOf(':')
+    }
+
+    fun host(value: String): String {
+        val split = separator(value)
+        require(split >= 0) { "Missing NFS export separator" }
+        return value.substring(0, split).removePrefix("[").removeSuffix("]")
+    }
+
+    fun exportPath(value: String): String {
+        val split = separator(value)
+        require(split >= 0) { "Missing NFS export separator" }
+        return value.substring(split + 1)
+    }
+}
diff --git a/main/filestation/nfsclientlib/src/test/java/com/lenovo/hec/lenovoextend/nfsclientlib/NfsServerAddressTest.kt b/main/filestation/nfsclientlib/src/test/java/com/lenovo/hec/lenovoextend/nfsclientlib/NfsServerAddressTest.kt
