+++ b/main/app/src/test/java/com/motorola/smartconnect/connectivity/nan/NanPeerBindingsTest.java
@@ -0,0 +1,55 @@
+package com.motorola.smartconnect.connectivity.nan;
+
+import static org.junit.Assert.*;
+import java.util.*;
+import org.junit.Test;
+
+public class NanPeerBindingsTest {
+    private static final class Memory implements NanPeerBindings.Storage {
+        final Map<String, String> aliases = new HashMap<>();
+        final Set<String> blocked = new HashSet<>();
+        public String alias(String id) { return aliases.get(id); }
+        public boolean blocked(String id) { return blocked.contains(id); }
+        public void put(String id, String alias, boolean failed) {
+            if (alias == null) aliases.remove(id); else aliases.put(id, alias);
+            if (failed) blocked.add(id); else blocked.remove(id);
+        }
+    }
+
+    @Test public void authenticationAssociatesNonceAndStableIdentity() {
+        NanPeerBindings peers = new NanPeerBindings(new Memory());
+        assertNull(peers.alias("real-phone"));
+        assertTrue(peers.authenticated("nonce", null, "real-phone", "paired-alias"));
+        assertEquals("paired-alias", peers.alias("nonce"));
+        assertEquals("paired-alias", peers.alias("real-phone"));
+    }
+
+    @Test public void anotherAuthenticatedDeviceCannotOverwriteKnownIdentity() {
+        NanPeerBindings peers = new NanPeerBindings(new Memory());
+        assertTrue(peers.authenticated("nonce", "phone-A", "phone-A", "alias-A"));
+        assertFalse(peers.authenticated("nonce", "phone-A", "phone-B", "alias-B"));
+        assertEquals("alias-A", peers.alias("nonce"));
+        assertEquals("alias-A", peers.alias("phone-A"));
+        assertNull(peers.alias("phone-B"));
+    }
+
+    @Test public void verificationFailureRequiresExplicitRepairWithoutAffectingOtherDevices() {
+        NanPeerBindings peers = new NanPeerBindings(new Memory());
+        peers.authenticated("a", "a", "a", "alias-a");
+        peers.authenticated("b", "b", "b", "alias-b");
+        peers.verificationFailed("a");
+        assertTrue(peers.blocked("a"));
+        assertFalse(peers.blocked("b"));
+        peers.allowManualRepair("a");
+        assertFalse(peers.blocked("a"));
+        assertNull(peers.alias("a"));
+        assertEquals("alias-b", peers.alias("b"));
+    }
+
+    @Test public void missingIdentityOrPairingAliasCannotBecomeAutoConnectBinding() {
+        NanPeerBindings peers = new NanPeerBindings(new Memory());
+        assertFalse(peers.authenticated("nonce", null, "", "alias"));
+        assertFalse(peers.authenticated("nonce", null, "real", null));
+        assertNull(peers.alias("nonce"));
+    }
+}
