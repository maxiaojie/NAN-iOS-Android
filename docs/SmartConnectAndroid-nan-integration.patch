+/* Copyright (c) 2026 Motorola Mobility LLC. Confidential and Restricted. */
+package com.motorola.smartconnect.connectivity.nan;
+
+/** Stores public pairing aliases, never NIK/NPK. Only an authenticated WSS may bind identity. */
+final class NanPeerBindings {
+    interface Storage {
+        String alias(String identity);
+        boolean blocked(String identity);
+        void put(String identity, String alias, boolean blocked);
+    }
+
+    private final Storage storage;
+
+    NanPeerBindings(Storage storage) { this.storage = storage; }
+
+    String alias(String identity) { return storage.alias(identity); }
+    boolean blocked(String identity) { return storage.blocked(identity); }
+
+    boolean authenticated(String requested, String expectedRealId, String actualRealId, String alias) {
+        if (empty(actualRealId) || empty(alias)
+                || (!empty(expectedRealId) && !expectedRealId.equals(actualRealId))) return false;
+        storage.put(actualRealId, alias, false);
+        if (!empty(requested)) storage.put(requested, alias, false);
+        return true;
+    }
+
+    void verificationFailed(String identity) {
+        storage.put(identity, storage.alias(identity), true);
+    }
+
+    void allowManualRepair(String identity) {
+        // Invalidate our association only; leave system pairing credentials intact.
+        storage.put(identity, null, false);
+    }
+
+    private static boolean empty(String value) { return value == null || value.isEmpty(); }
+}
