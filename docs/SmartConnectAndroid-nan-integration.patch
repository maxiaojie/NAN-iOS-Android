+import java.util.concurrent.*;
+
+/** Main-thread-owned Aware sessions. Existing WSS keeps responsibility for TLS and Token trust. */
+@SuppressLint("MissingPermission")
+public final class NanTransport implements AutoCloseable {
+    public static final String SERVICE = NanPolicy.SERVICE;
+    public static final int TYPE = 10;
+    private static final Handler MAIN = new Handler(Looper.getMainLooper());
+    private static final Map<String, NanTransport> SESSIONS = new ConcurrentHashMap<>();
+
+    public interface Listener {
+        void ready(Network network, Inet6Address peer, LinkProperties local);
+
+        void failed(String reason);
+    }
+
+    final String id = UUID.randomUUID().toString();
+    final Context context;
+    final boolean publisher;
+    final Listener listener;
+    final int port;
+    final String instance;
+    final Map<PeerHandle, String> peers = new LinkedHashMap<>();
+    final Map<PeerHandle, String> aliases = new HashMap<>();
+    final Map<PeerHandle, String> pins = new HashMap<>();
+    final Map<PeerHandle, Integer> acceptedRequests = new HashMap<>();
+    final CompletableFuture<List<String>> publication = new CompletableFuture<>();
+    WifiAwareSession aware;
+    DiscoverySession discovery;
+    ConnectivityManager.NetworkCallback callback;
+    PeerHandle selected;
+    Network network;
+    WifiAwareNetworkInfo info;
+    LinkProperties properties;
+    boolean closed, delivered;
+    NanPairingActivity ui;
+    String status = "正在准备 Wi-Fi Aware";
+    private final Runnable timeout = () -> fail("Wi-Fi Aware 配对或连接超时");
+
+    private NanTransport(Context c, boolean pub, int p, String instance, Listener l) {
+        context = c.getApplicationContext();
+        publisher = pub;
+        port = p;
+        this.instance = instance;
+        listener = l;
+        SESSIONS.put(id, this);
+        android.util.Log.i("SmartConnectNAN", "Created session " + id + " publisher=" + publisher);
+    }
+
+    public static List<String> parse(List<Map<String, List<String>>> policies) {
+        if (policies != null)
+            for (Map<String, List<String>> p : policies)
+                if (p != null && p.containsKey("nan")) return p.get("nan");
+        return null;
+    }
+
+    public static boolean supported(Context c) {
+        return Build.VERSION.SDK_INT >= 37 && c.getSystemService(WifiAwareManager.class) != null;
+    }
+
+    public static NanTransport connect(Context c, List<String> policy, Listener l) {
+        int port = NanPolicy.port(policy);
+        NanTransport s = new NanTransport(c, false, port, policy.get(2), l);
+        MAIN.post(s::startUI);
+        return s;
+    }
+
+    public static List<String> publish(Context c, int port, String token) {
+        if (!supported(c) || Looper.myLooper() == Looper.getMainLooper()) return null;
+        for (NanTransport old : SESSIONS.values())
+            if (old.publisher && !old.closed) {
+                if (old.instance.equals(token) && old.port == port)
+                    return old.publication.getNow(null);
+                return null; // Never advertise a different WSS endpoint through an occupied
+                // service.
+            }
+        NanTransport s = new NanTransport(c, true, port, token, null);
+        MAIN.post(s::startUI);
+        try {
+            return s.publication.get(20, TimeUnit.SECONDS);
+        } catch (Exception e) {
+            s.close();
+            return null;
+        }
+    }
+
+    public static void closePublisher(String token) {
+        for (NanTransport s : SESSIONS.values())
+            if (s.publisher && s.instance.equals(token)) s.close();
+    }
+
+    static NanTransport find(String id) {
+        return SESSIONS.get(id);
+    }
+
+    private void startUI() {
+        if (closed) return;
