@@ -0,0 +1,30 @@
+/* Copyright (c) 2026 Motorola Mobility LLC. Confidential and Restricted. */
+package com.motorola.smartconnect.connectivity.nan;
+
+import java.util.List;
+
+/** Versioned wire contract shared with SmartConnect iOS. */
+public final class NanPolicy {
+    public static final String SERVICE = "_smartconnect._tcp";
+
+    private NanPolicy() {}
+
+    public static int port(List<String> values) {
+        if (values == null
+                || values.size() != 4
+                || !"1".equals(values.get(0))
+                || !SERVICE.equals(values.get(1))
+                || values.get(2) == null
+                || values.get(2).length() < 8
+                || values.get(2).length() > 128)
+            throw new IllegalArgumentException("Unsupported NAN policy");
+        int port;
+        try {
+            port = Integer.parseInt(values.get(3));
+        } catch (RuntimeException e) {
+            throw new IllegalArgumentException("Invalid NAN port", e);
+        }
+        if (port < 1 || port > 65535) throw new IllegalArgumentException("Invalid NAN port");
+        return port;
+    }
+}
