+/* Copyright (c) 2026 Motorola Mobility LLC. Confidential and Restricted. */
+package com.motorola.smartconnect.connectivity.nan;
+
+import android.net.Network;
+
+import java.io.IOException;
+import java.net.*;
+
+import javax.net.SocketFactory;
+
+/** Bind the existing fingerprint-pinned TLS socket before connecting; never bind the process. */
+public final class NetworkTlsSocketFactory extends SocketFactory {
+    private final SocketFactory delegate;
+    private final Network network;
+
+    public NetworkTlsSocketFactory(SocketFactory delegate, Network network) {
+        this.delegate = delegate;
+        this.network = network;
+    }
+
+    @Override
+    public Socket createSocket() throws IOException {
+        Socket socket = delegate.createSocket();
+        try {
+            network.bindSocket(socket);
+            return socket;
+        } catch (IOException | RuntimeException e) {
+            socket.close();
+            throw e;
+        }
+    }
+
+    private Socket open(InetAddress host, int port, InetAddress local, int localPort)
+            throws IOException {
+        Socket s = createSocket();
+        try {
+            if (local != null) s.bind(new InetSocketAddress(local, localPort));
+            s.connect(new InetSocketAddress(host, port), 5000);
+            return s;
+        } catch (IOException | RuntimeException e) {
+            s.close();
+            throw e;
+        }
+    }
+
+    @Override
+    public Socket createSocket(String h, int p) throws IOException {
+        return open(network.getByName(h), p, null, 0);
+    }
+
+    @Override
+    public Socket createSocket(InetAddress h, int p) throws IOException {
+        return open(h, p, null, 0);
+    }
+
+    @Override
+    public Socket createSocket(String h, int p, InetAddress l, int lp) throws IOException {
+        return open(network.getByName(h), p, l, lp);
+    }
+
+    @Override
+    public Socket createSocket(InetAddress h, int p, InetAddress l, int lp) throws IOException {
+        return open(h, p, l, lp);
+    }
+}
