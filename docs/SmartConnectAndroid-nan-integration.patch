+        if (!supported(context)) {
+            fail("此功能需要 Android 17 和 Wi-Fi Aware 支持");
+            return;
+        }
+        try {
+            context.startActivity(
+                    new Intent(context, NanPairingActivity.class)
+                            .putExtra("session", id)
+                            .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK));
+        } catch (RuntimeException e) {
+            fail("无法显示 Wi-Fi Aware 配对界面");
+        }
+    }
+
+    void start() {
+        if (closed || aware != null) return;
+        android.util.Log.i("SmartConnectNAN", "Starting Aware " + id);
+        try {
+            WifiAwareManager manager = context.getSystemService(WifiAwareManager.class);
+            if (!manager.isAvailable() || !manager.getCharacteristics().isAwarePairingSupported())
+                throw new IllegalStateException("请开启 Wi-Fi、定位并检查配对支持");
+            MAIN.postDelayed(timeout, 130000);
+            manager.attach(
+                    new AttachCallback() {
+                        @Override
+                        public void onAttached(WifiAwareSession s) {
+                            if (closed) {
+                                s.close();
+                                return;
+                            }
+                            aware = s;
+                            discover();
+                        }
+
+                        @Override
+                        public void onAttachFailed() {
+                            fail("Aware attach 失败");
+                        }
+
+                        @Override
+                        public void onAwareSessionTerminated() {
+                            fail("Aware 会话已终止");
+                        }
+                    },
+                    MAIN);
+        } catch (RuntimeException e) {
+            fail(e.getMessage());
+        }
+    }
+
+    private AwarePairingConfig pairing() {
+        return new AwarePairingConfig.Builder()
+                .setPairingSetupEnabled(true)
+                .setPairingVerificationEnabled(true)
+                .setPairingCacheEnabled(true)
+                .setSupportedCipherSuites(Characteristics.WIFI_AWARE_CIPHER_SUITE_NCS_PK_PASN_128)
+                .setBootstrappingMethods(
+                        publisher
+                                ? AwarePairingConfig.PAIRING_BOOTSTRAPPING_PIN_CODE_DISPLAY
+                                : AwarePairingConfig.PAIRING_BOOTSTRAPPING_PIN_CODE_KEYPAD)
+                .build();
+    }
+
+    private void discover() {
+        try {
+            if (publisher)
+                aware.publish(
+                        new PublishConfig.Builder()
+                                .setServiceName(SERVICE)
+                                .setPublishType(PublishConfig.PUBLISH_TYPE_SOLICITED)
+                                .setPairingConfig(pairing())
+                                .setServiceSpecificInfo(metadata(true))
+                                .build(),
+                        events,
+                        MAIN);
+            else
+                aware.subscribe(
+                        new SubscribeConfig.Builder()
+                                .setServiceName(SERVICE)
+                                .setSubscribeType(SubscribeConfig.SUBSCRIBE_TYPE_ACTIVE)
+                                .setPairingConfig(pairing())
+                                .build(),
+                        events,
+                        MAIN);
+        } catch (RuntimeException e) {
+            fail(e.getMessage());
+        }
+    }
+
+    private final DiscoverySessionCallback events =
+            new DiscoverySessionCallback() {
+                @Override
+                public void onPublishStarted(PublishDiscoverySession s) {
+                    if (closed) {
+                        s.close();
+                        return;
+                    }
+                    discovery = s;
+                    publication.complete(
+                            Arrays.asList("1", SERVICE, instance, String.valueOf(port)));
+                    status = "服务已发布；等待对端配对或连接";
+                    refresh();
+                    // Return to the invitation QR. Show this activity again when a PIN is needed.
+                    if (ui != null) ui.finish();
+                    requestNetwork(null);
+                }
+
+                @Override
+                public void onSubscribeStarted(SubscribeDiscoverySession s) {
+                    android.util.Log.i("SmartConnectNAN", "Subscribe started " + id);
+                    if (closed) {
+                        s.close();
+                        return;
+                    }
+                    discovery = s;
+                    status = "选择邀请方设备";
+                    refresh();
+                }
+
+                @Override
+                public void onServiceDiscovered(ServiceDiscoveryInfo d) {
+                    if (closed) return;
+                    PeerHandle p = d.getPeerHandle();
+                    Map<String, String> names = PeerDeviceInfo.parse(d.getServiceSpecificInfo());
+                    String label = names.getOrDefault(
+                                            "pairingName", names.getOrDefault("modelName", "附近设备"))
+                                    + " #"
+                                    + p.hashCode();
+                    String previous = peers.put(p, label);
+                    if (d.getPairedAlias() != null) aliases.put(p, d.getPairedAlias());
+                    if (!label.equals(previous)) refresh();
+                }
+
+                @Override
+                public void onBootstrappingSucceeded(PeerHandle p, int method) {
+                    if (closed) return;
+                    if (publisher) {
+                        pin(p);
+                        status = "请在对端输入代码：" + pins.get(p);
+                        if (ui == null || ui.isFinishing()) startUI();
+                        refresh();
+                    } else if (p.equals(selected) && ui != null) ui.enterPin();
+                }
+
+                @Override
+                public void onPairingSetupRequestReceived(PeerHandle p, int request) {
+                    try {
+                        if (publisher) {
+                            Integer accepted = acceptedRequests.get(p);
+                            if (accepted != null) {
+                                if (accepted != request) discovery.rejectPairingRequest(request, p);
+                                return;
+                            }
+                            acceptedRequests.put(p, request);
+                            discovery.acceptPairingRequest(
+                                    request,
+                                    p,
+                                    "smartconnect-" + UUID.randomUUID(),
+                                    Characteristics.WIFI_AWARE_CIPHER_SUITE_NCS_PK_PASN_128,
+                                    pin(p));
+                        } else discovery.rejectPairingRequest(request, p);
+                    } catch (RuntimeException e) {
+                        fail(e.getMessage());
+                    }
+                }
+
+                @Override
+                public void onPairingSetupSucceeded(PeerHandle p, String alias) {
+                    aliases.put(p, alias);
+                    acceptedRequests.remove(p);
+                    pins.remove(p);
+                    status = "系统配对成功，正在连接";
+                    refresh();
+                    if (!publisher && p.equals(selected)) requestNetwork(p);
+                }
+
+                @Override
+                public void onPairingSetupFailed(PeerHandle p) {
+                    fail("系统配对失败，请核对 PIN");
+                }
+
+                @Override
+                public void onBootstrappingFailed(PeerHandle p) {
+                    fail("配对方式协商失败");
+                }
+
+                @Override
+                public void onPairingVerificationFailed(PeerHandle p) {
+                    fail("已有配对验证失败，请在两端清理旧配对后重试");
+                }
+
+                @Override
+                public void onSessionConfigFailed() {
+                    fail("Aware 服务配置失败");
+                }
+
+                @Override
+                public void onSessionTerminated() {
+                    fail("Aware 发现会话结束");
+                }
+            };
+
+    void select(PeerHandle p) {
+        if (closed || selected != null || discovery == null) return;
+        android.util.Log.i("SmartConnectNAN", "Selected peer; paired=" + aliases.containsKey(p));
+        selected = p;
+        try {
+            if (aliases.containsKey(p)) requestNetwork(p);
+            else bootstrapWithMetadata(p, metadata(false));
+        } catch (RuntimeException e) {
+            fail(e.getMessage());
+        }
+    }
+
+    void submitPin(String pin) {
+        if (closed || selected == null) return;
+        try {
+            discovery.initiatePairingRequest(
+                    selected,
+                    "smartconnect-" + UUID.randomUUID(),
+                    Characteristics.WIFI_AWARE_CIPHER_SUITE_NCS_PK_PASN_128,
+                    pin);
+        } catch (RuntimeException e) {
+            fail(e.getMessage());
+        }
+    }
+
+    private String pin(PeerHandle p) {
+        String value = pins.get(p);
+        if (value == null) {
+            value = String.format(Locale.ROOT, "%06d", new SecureRandom().nextInt(1000000));
+            pins.put(p, value);
+        }
+        return value;
+    }
+
+    private void requestNetwork(PeerHandle p) {
+        if (closed || callback != null) return;
+        try {
+            WifiAwareNetworkSpecifier spec =
+                    publisher
+                            ? new WifiAwareNetworkSpecifier.Builder(
+                                            (PublishDiscoverySession) discovery)
+                                    .setPskPassphrase(invitationPassphrase())
+                                    .setPort(port)
+                                    .setTransportProtocol(6)
+                                    .build()
+                            : new WifiAwareNetworkSpecifier.Builder(discovery, p).build();
+            callback =
+                    new ConnectivityManager.NetworkCallback() {
+                        @Override
+                        public void onAvailable(Network n) {
+                            network = n;
+                            ready();
+                        }
+
+                        @Override
+                        public void onCapabilitiesChanged(Network n, NetworkCapabilities caps) {
+                            if (caps.getTransportInfo() instanceof WifiAwareNetworkInfo) {
+                                info = (WifiAwareNetworkInfo) caps.getTransportInfo();
+                                ready();
+                            }
+                        }
+
+                        @Override
+                        public void onLinkPropertiesChanged(Network n, LinkProperties props) {
+                            properties = props;
+                            ready();
+                        }
+
+                        @Override
+                        public void onLost(Network n) {
+                            fail("Aware 数据链路已断开");
+                        }
+
+                        @Override
+                        public void onUnavailable() {
+                            fail("Aware 数据链路请求失败");
+                        }
+                    };
+            context.getSystemService(ConnectivityManager.class)
+                    .requestNetwork(
+                            new NetworkRequest.Builder()
+                                    .addTransportType(NetworkCapabilities.TRANSPORT_WIFI_AWARE)
+                                    .setNetworkSpecifier(spec)
+                                    .build(),
+                            callback,
+                            MAIN,
+                            publisher ? 130000 : 30000);
+        } catch (RuntimeException e) {
+            fail(e.getMessage());
+        }
+    }
+
+    private void ready() {
+        if (closed || delivered || network == null || properties == null) return;
+        // A responder may not receive initiator-only peer transport information.
+        // Its existing WSS listener only needs the acquired Network to stay alive.
+        if (!publisher && (info == null || info.getPeerIpv6Addr() == null)) return;
+        delivered = true;
+        MAIN.removeCallbacks(timeout);
+        status = "Aware 数据链路已建立";
+        refresh();
+        if (ui != null) ui.finish();
+        if (listener != null) listener.ready(network, info == null ? null : info.getPeerIpv6Addr(), properties);
+    }
+
+    private String invitationPassphrase() {
+        try {
+            byte[] digest = java.security.MessageDigest.getInstance("SHA-256")
+                    .digest(instance.getBytes(StandardCharsets.UTF_8));
+            return android.util.Base64.encodeToString(digest, android.util.Base64.NO_WRAP);
+        } catch (java.security.NoSuchAlgorithmException e) {
+            throw new IllegalStateException("SHA-256 unavailable", e);
+        }
+    }
+
+    void refresh() {
+        if (ui != null) ui.refresh();
+    }
+
+    void fail(String why) {
+        if (closed) return;
+        android.util.Log.w("SmartConnectNAN", "Session failed: " + why);
+        android.widget.Toast.makeText(
+                        context,
+                        why == null ? "Wi-Fi Aware 操作失败" : why,
+                        android.widget.Toast.LENGTH_LONG)
+                .show();
+        publication.complete(null);
+        if (listener != null) listener.failed(why == null ? "Aware 操作失败" : why);
+        close();
+    }
+
+    @Override
+    public void close() {
+        if (Looper.myLooper() == Looper.getMainLooper()) closeOnMain();
+        else MAIN.post(this::closeOnMain);
+    }
+
+    private void closeOnMain() {
+        if (closed) return;
+        android.util.Log.i("SmartConnectNAN", "Closing session " + id);
+        closed = true;
+        MAIN.removeCallbacks(timeout);
+        SESSIONS.remove(id);
+        publication.complete(null);
+        if (callback != null) {
+            try {
+                context.getSystemService(ConnectivityManager.class)
+                        .unregisterNetworkCallback(callback);
+            } catch (RuntimeException ignored) {
+            }
+            callback = null;
+        }
+        if (discovery != null) discovery.close();
+        if (aware != null) aware.close();
+        pins.clear();
+        acceptedRequests.clear();
+        if (ui != null) ui.finish();
+    }
+
+    // OEM fwk.jar precedes android.jar and still declares API 36. Resolve these
+    // public API 37 additions without falling back to the overload that drops TXT.
+    private void bootstrapWithMetadata(PeerHandle peer, byte[] txt) {
+        try {
+            DiscoverySession.class
+                    .getMethod(
+                            "initiateBootstrappingRequest",
+                            PeerHandle.class,
+                            int.class,
+                            byte[].class)
+                    .invoke(
+                            discovery,
+                            peer,
+                            AwarePairingConfig.PAIRING_BOOTSTRAPPING_PIN_CODE_KEYPAD,
+                            txt);
+        } catch (ReflectiveOperationException e) {
+            throw new IllegalStateException("ROM 不支持 Android 17 Bootstrap 设备信息接口", e);
+        }
+    }
+
+    private byte[] bootstrapTxt(Map<String, String> values) {
+        try {
+            return (byte[])
+                    WifiAwareManager.class
+                            .getMethod("createTxtRecordTlvBuffer", Map.class)
+                            .invoke(null, values);
+        } catch (ReflectiveOperationException e) {
+            throw new IllegalStateException("ROM 不支持 Android 17 配对 TXT 接口", e);
+        }
+    }
+
+    private byte[] metadata(boolean envelope) {
+        Map<String, String> m = new LinkedHashMap<>();
+        m.put("modelName", bounded(Build.MODEL));
+        m.put(
+                "pairingName",
+                bounded(Settings.Global.getString(context.getContentResolver(), "device_name")));
+        m.put("vendorName", bounded(Build.MANUFACTURER));
+        if (!envelope) return bootstrapTxt(m);
+        ByteArrayOutputStream txt = new ByteArrayOutputStream();
+        for (Map.Entry<String, String> e : m.entrySet()) {
+            byte[] b = (e.getKey() + "=" + e.getValue()).getBytes(StandardCharsets.UTF_8);
+            txt.write(b.length);
+            txt.write(b, 0, b.length);
+        }
+        byte[] data = txt.toByteArray();
+        ByteArrayOutputStream out = new ByteArrayOutputStream();
+        out.write(4);
+        out.write(data.length & 255);
+        out.write(data.length >> 8);
+        out.write(data, 0, data.length);
+        return out.toByteArray();
+    }
+
+    private static String bounded(String s) {
+        if (s == null || s.isEmpty()) s = "Android";
+        while (s.getBytes(StandardCharsets.UTF_8).length > 63)
+            s = s.substring(0, s.offsetByCodePoints(s.length(), -1));
+        return s;
+    }
+}
