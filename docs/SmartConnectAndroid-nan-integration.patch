+/* Copyright (c) 2026 Motorola Mobility LLC. Confidential and Restricted. */
+package com.motorola.smartconnect.connectivity.nan;
+
+import android.Manifest;
+import android.app.*;
+import android.content.pm.PackageManager;
+import android.net.wifi.aware.PeerHandle;
+import android.os.*;
+import android.widget.*;
+
+import java.util.*;
+
+/** Explicit foreground user selection; names never replace WSS fingerprint authentication. */
+public final class NanPairingActivity extends Activity {
+    private NanTransport session;
+    private TextView status;
+    private LinearLayout content;
+
+    @Override
+    public void onCreate(Bundle b) {
+        super.onCreate(b);
+        session = NanTransport.find(getIntent().getStringExtra("session"));
+        android.util.Log.i("SmartConnectNAN", "UI session found=" + (session != null));
+        if (session == null) {
+            finish();
+            return;
+        }
+        session.ui = this;
+        setTitle("Wi-Fi Aware");
+        content = new LinearLayout(this);
+        content.setOrientation(LinearLayout.VERTICAL);
+        content.setPadding(32, 32, 32, 32);
+        status = new TextView(this);
+        content.addView(status);
+        setContentView(content);
+        refresh();
+        if (checkSelfPermission(Manifest.permission.NEARBY_WIFI_DEVICES)
+                        != PackageManager.PERMISSION_GRANTED
+                || checkSelfPermission(Manifest.permission.ACCESS_FINE_LOCATION)
+                        != PackageManager.PERMISSION_GRANTED)
+            requestPermissions(
+                    new String[] {
+                        Manifest.permission.NEARBY_WIFI_DEVICES,
+                        Manifest.permission.ACCESS_FINE_LOCATION
+                    },
+                    1);
+        else session.start();
+    }
+
+    @Override
+    public void onRequestPermissionsResult(int r, String[] p, int[] grants) {
+        super.onRequestPermissionsResult(r, p, grants);
+        if (r == 1) {
+            boolean ok = grants.length == 2;
+            for (int g : grants) ok &= g == PackageManager.PERMISSION_GRANTED;
+            if (ok) session.start();
+            else session.fail("Wi-Fi Aware 需要附近设备与定位权限");
+        }
+    }
+
+    void refresh() {
+        if (session == null || status == null) return;
+        status.setText(session.status);
+        while (content.getChildCount() > 1) content.removeViewAt(1);
+        if (!session.publisher && session.selected == null)
+            for (Map.Entry<PeerHandle, String> e : session.peers.entrySet()) {
+                Button button = new Button(this);
+                button.setText(e.getValue());
+                button.setOnClickListener(v -> session.select(e.getKey()));
+                content.addView(button);
+            }
+    }
+
+    void enterPin() {
+        EditText field = new EditText(this);
+        field.setInputType(2);
+        new AlertDialog.Builder(this)
+                .setTitle("输入对端显示的代码")
+                .setView(field)
+                .setPositiveButton(
+                        "配对",
+                        (d, w) -> {
+                            String pin = field.getText().toString();
+                            if (pin.matches("[0-9]{6}")) session.submitPin(pin);
+                            else session.fail("PIN 必须为六位数字");
+                        })
+                .setNegativeButton("取消", (d, w) -> session.fail("已取消配对"))
+                .setOnCancelListener(d -> session.fail("已取消配对"))
+                .show();
+    }
+
+    @Override
+    public void onBackPressed() {
+        if (session != null) session.fail("已取消 Wi-Fi Aware 操作");
+        super.onBackPressed();
+    }
+
+    @Override
+    public void onDestroy() {
+        if (session != null && session.ui == this) session.ui = null;
+        super.onDestroy();
+    }
+}
