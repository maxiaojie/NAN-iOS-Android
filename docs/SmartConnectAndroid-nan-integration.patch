index 0000000000..be8e186c10
--- /dev/null
+++ b/main/app/src/main/java/com/motorola/smartconnect/connectivity/nan/NanTransport.java
@@ -0,0 +1,735 @@
+/* Copyright (c) 2026 Motorola Mobility LLC. Confidential and Restricted. */
+package com.motorola.smartconnect.connectivity.nan;
+
+import android.annotation.SuppressLint;
+import android.Manifest;
+import android.content.pm.PackageManager;
+import android.content.*;
+import android.net.*;
+import android.net.wifi.aware.*;
+import android.os.*;
+import android.provider.Settings;
+
+import java.io.*;
+import java.net.*;
+import java.nio.charset.StandardCharsets;
+import java.security.SecureRandom;
+import java.util.*;
+import java.util.concurrent.*;
+
+/** Main-thread-owned Aware sessions. Existing WSS keeps responsibility for TLS and Token trust. */
+@SuppressLint("MissingPermission")
+public final class NanTransport implements AutoCloseable {
+    public static final String SERVICE = NanPolicy.SERVICE;
+    public static final int TYPE = 10;
+    private static final Handler MAIN = new Handler(Looper.getMainLooper());
+    private static final Map<String, NanTransport> SESSIONS = new ConcurrentHashMap<>();
+
+    private static final Map<String, NanTransport> SUBSCRIBERS = new HashMap<>();
+    private static final Map<String, Long> RETRY_AFTER = new HashMap<>();
+
+    public interface Listener {
+        void ready(Network network, Inet6Address peer, LinkProperties local);
+
+        void failed(String reason);
+    }
+
+    final String id = UUID.randomUUID().toString();
+    final Context context;
+    final boolean publisher;
+    final Set<Connection> connections = new LinkedHashSet<>();
+    String targetIdentity;
+    String authenticatedIdentity;
+    String expectedAlias;
+    boolean attaching;
+    boolean allowInteraction;
+    boolean uiRequested;
+    boolean needsPin;
+    final int port;
+    final String instance;
+    final Map<PeerHandle, String> peers = new LinkedHashMap<>();
+    final Map<PeerHandle, String> aliases = new HashMap<>();
+    final Set<PeerHandle> verifiedPeers = new HashSet<>();
+    final Map<PeerHandle, String> pins = new HashMap<>();
+    final Map<PeerHandle, Integer> acceptedRequests = new HashMap<>();
+    final CompletableFuture<List<String>> publication = new CompletableFuture<>();
+    WifiAwareSession aware;
+    DiscoverySession discovery;
+    ConnectivityManager.NetworkCallback callback;
+    PeerHandle selected;
+    Network network;
+    WifiAwareNetworkInfo info;
+    LinkProperties properties;
+    volatile boolean closed;
+    boolean delivered;
+    NanPairingActivity ui;
+    String status = "正在准备 Wi-Fi Aware";
+    private final Runnable timeout = () -> fail("Wi-Fi Aware 配对或连接超时");
+    private final Runnable selectionFallback = () -> {
+        if (!closed && selected == null && expectedAlias == null && allowInteraction) startUI();
+    };
+
+
+    private NanTransport(Context c, boolean pub, int p, String instance) {
+        context = c.getApplicationContext();
+        publisher = pub;
+        port = p;
+        this.instance = instance;
+        SESSIONS.put(id, this);
+        android.util.Log.i("SmartConnectNAN", "Created session " + id + " publisher=" + publisher);
+    }
+
+    public static List<String> parse(List<Map<String, List<String>>> policies) {
+        if (policies != null)
+            for (Map<String, List<String>> p : policies)
+                if (p != null && p.containsKey("nan")) return p.get("nan");
+        return null;
+    }
+
+    public static boolean supported(Context c) {
+        return Build.VERSION.SDK_INT >= 37 && c.getSystemService(WifiAwareManager.class) != null;
+    }
+
+    /** One WSS owner of a shared NDP. Closing one owner cannot tear down another WSS. */
+    public static final class Connection implements AutoCloseable {
+        private final Listener listener;
+        private final String target;
+        private final String expectedRealId;
+        private final java.util.concurrent.atomic.AtomicBoolean closed = new java.util.concurrent.atomic.AtomicBoolean();
+        private NanTransport transport;
+        private boolean notifiedReady;
+
+        private Connection(String target, String expectedRealId, Listener listener) {
+            this.target = target;
+            this.expectedRealId = expectedRealId;
+            this.listener = listener;
+        }
+
+        /** Invoke only after WSS fingerprint, token and remote identity verification succeeded. */
+        public void authenticated(String realDeviceId) {
+            if (closed.get()) return;
+            MAIN.post(() -> {
+                NanTransport s = transport;
+                if (s == null || s.closed || s.selected == null) return;
+                String alias = s.aliases.get(s.selected);
+                if (s.bindings().authenticated(target, expectedRealId, realDeviceId, alias)) {
+                    s.expectedAlias = alias;
+                    s.authenticatedIdentity = realDeviceId;
+                    SUBSCRIBERS.putIfAbsent(realDeviceId, s);
+                    android.util.Log.i("SmartConnectNAN", "Authenticated device/alias association saved");
+                } else {
+                    android.util.Log.w("SmartConnectNAN", "Device/alias association rejected");
+                }
+            });
+        }
+
+        private void ready() {
+            NanTransport s = transport;
+            if (closed.get() || notifiedReady || s == null || !s.delivered) return;
+            notifiedReady = true;
+            listener.ready(s.network, s.info.getPeerIpv6Addr(), s.properties);
+        }
+
+        private void failed(String reason) {
+            if (closed.compareAndSet(false, true)) listener.failed(reason);
+        }
+
+        @Override public void close() {
+            if (!closed.compareAndSet(false, true)) return;
+            MAIN.post(() -> {
+                NanTransport s = transport;
+                if (s != null) {
+                    s.connections.remove(this);
+                    if (s.connections.isEmpty()) s.closeOnMain();
+                }
+                transport = null;
+            });
+        }
+    }
+
+    public static Connection connect(Context c, String target, String expectedRealId,
+            List<String> policy, boolean interactive, Listener listener) {
+        int port = NanPolicy.port(policy);
+        if (target == null || target.isEmpty()) throw new IllegalArgumentException("Missing NAN device identity");
+        Connection owner = new Connection(target, expectedRealId, listener);
+        MAIN.post(() -> {
+            if (owner.closed.get()) return;
+            NanTransport existing = SUBSCRIBERS.get(target);
+            if (existing != null && !existing.closed) {
+                owner.transport = existing;
+                existing.connections.add(owner);
+                existing.allowInteraction |= interactive;
+                if (existing.delivered) owner.ready();
+                else if (interactive && existing.selected == null) {
+                    MAIN.removeCallbacks(existing.selectionFallback);
+                    MAIN.postDelayed(existing.selectionFallback, 1500);
+                }
+                android.util.Log.i("SmartConnectNAN", "Reused device NDP; owners=" + existing.connections.size());
+                return;
+            }
+            NanTransport s = new NanTransport(c, false, port, policy.get(2));
+            s.targetIdentity = target;
+            s.allowInteraction = interactive;
+            NanPeerBindings bindings = s.bindings();
+            if (bindings.blocked(target)) {
+                if (!interactive) {
+                    owner.failed("NAN 配对验证已失败，请手动连接并重新关联设备");
+                    s.closeOnMain();
+                    return;
+                }
+                bindings.allowManualRepair(target);
+            }
+            s.expectedAlias = bindings.alias(target);
+            if (!interactive && (s.expectedAlias == null || s.expectedAlias.isEmpty())) {
+                owner.failed("请先手动连接一次，关联此设备的 NAN 配对记录");
+                s.closeOnMain();
+                return;
+            }
+            if (!interactive && SystemClock.elapsedRealtime() < RETRY_AFTER.getOrDefault(target, 0L)) {
+                owner.failed("NAN 重连退避中");
+                s.closeOnMain();
+                return;
+            }
+            owner.transport = s;
+            s.connections.add(owner);
+            SUBSCRIBERS.put(target, s);
+            s.begin();
+        });
+        return owner;
+    }
+
+    private NanPeerBindings bindings() {
+        android.content.SharedPreferences prefs = context.getSharedPreferences("smartconnect_nan_peers", Context.MODE_PRIVATE);
+        return new NanPeerBindings(new NanPeerBindings.Storage() {
+            private String key(String identity) {
+                try {
+                    byte[] bytes = java.security.MessageDigest.getInstance("SHA-256")
+                            .digest(identity.getBytes(StandardCharsets.UTF_8));
+                    return android.util.Base64.encodeToString(bytes, android.util.Base64.NO_WRAP);
+                } catch (java.security.NoSuchAlgorithmException e) { throw new IllegalStateException(e); }
+            }
+            public String alias(String identity) { return prefs.getString("alias:" + key(identity), null); }
+            public boolean blocked(String identity) { return prefs.getBoolean("blocked:" + key(identity), false); }
+            public void put(String identity, String alias, boolean blocked) {
+                String key = key(identity);
+                prefs.edit().putString("alias:" + key, alias).putBoolean("blocked:" + key, blocked).apply();
+            }
+        });
+    }
+
+    private boolean hasPermissions() {
+        return context.checkSelfPermission(Manifest.permission.NEARBY_WIFI_DEVICES) == PackageManager.PERMISSION_GRANTED
+                && context.checkSelfPermission(Manifest.permission.ACCESS_FINE_LOCATION) == PackageManager.PERMISSION_GRANTED;
+    }
+
+    private void begin() {
+        if (!hasPermissions()) {
+            if (allowInteraction) startUI();
+            else fail("Wi-Fi Aware 需要附近设备与定位权限，请在前台授权");
+            return;
+        }
+        start();
+    }
+
+    public static List<String> publish(Context c, int port, String token) {
+        if (!supported(c) || Looper.myLooper() == Looper.getMainLooper()) return null;
+        NanTransport session = null;
+        boolean created = false;
+        synchronized (SESSIONS) {
+            for (NanTransport old : SESSIONS.values()) {
+                if (old.publisher && !old.closed) {
+                    if (!old.instance.equals(token) || old.port != port) return null;
+                    session = old;
+                    break;
+                }
+            }
+            if (session == null) {
+                session = new NanTransport(c, true, port, token);
+                created = true;
+            }
+        }
+        final NanTransport s = session;
+        if (created) MAIN.post(s::begin);
+        try {
+            return s.publication.get(20, TimeUnit.SECONDS);
+        } catch (Exception e) {
+            s.close();
+            return null;
+        }
+    }
+
+    public static void closePublisher(String token) {
+        for (NanTransport s : SESSIONS.values())
+            if (s.publisher && s.instance.equals(token)) s.close();
+    }
+
+    static NanTransport find(String id) {
+        return SESSIONS.get(id);
+    }
+
+    private void startUI() {
+        if (closed || uiRequested || (ui != null && !ui.isFinishing())) return;
+        uiRequested = true;
+        android.util.Log.i("SmartConnectNAN", "Opening session UI " + id);
+        if (!supported(context)) {
+            fail("此功能需要 Android 17 和 Wi-Fi Aware 支持");
+            return;
+        }
+        try {
+            context.startActivity(
+                    new Intent(context, NanPairingActivity.class)
+                            .putExtra("session", id)
+                            .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK));
+        } catch (RuntimeException e) {
+            fail("无法显示 Wi-Fi Aware 配对界面");
+        }
+    }
+
+    void start() {
+        if (closed || aware != null || attaching) return;
+        attaching = true;
+        android.util.Log.i("SmartConnectNAN", "Starting Aware " + id);
+        try {
+            WifiAwareManager manager = context.getSystemService(WifiAwareManager.class);
+            if (!manager.isAvailable() || !manager.getCharacteristics().isAwarePairingSupported())
+                throw new IllegalStateException("请开启 Wi-Fi、定位并检查配对支持");
+            MAIN.postDelayed(timeout, 130000);
+            manager.attach(
+                    new AttachCallback() {
+                        @Override
+                        public void onAttached(WifiAwareSession s) {
+                            if (closed) {
+                                s.close();
+                                return;
+                            }
+                            aware = s;
+                            discover();
+                        }
+
+                        @Override
+                        public void onAttachFailed() {
+                            fail("Aware attach 失败");
+                        }
+
+                        @Override
+                        public void onAwareSessionTerminated() {
+                            fail("Aware 会话已终止");
+                        }
+                    },
+                    MAIN);
+        } catch (RuntimeException e) {
+            fail(e.getMessage());
+        }
+    }
+
+    private AwarePairingConfig pairing() {
+        return new AwarePairingConfig.Builder()
+                .setPairingSetupEnabled(true)
+                .setPairingVerificationEnabled(true)
+                .setPairingCacheEnabled(true)
+                .setSupportedCipherSuites(Characteristics.WIFI_AWARE_CIPHER_SUITE_NCS_PK_PASN_128)
+                .setBootstrappingMethods(
+                        publisher
+                                ? AwarePairingConfig.PAIRING_BOOTSTRAPPING_PIN_CODE_DISPLAY
+                                : AwarePairingConfig.PAIRING_BOOTSTRAPPING_PIN_CODE_KEYPAD)
+                .build();
+    }
+
+    private void discover() {
+        try {
+            if (publisher)
+                aware.publish(
+                        new PublishConfig.Builder()
+                                .setServiceName(SERVICE)
+                                .setPublishType(PublishConfig.PUBLISH_TYPE_SOLICITED)
+                                .setPairingConfig(pairing())
+                                .setServiceSpecificInfo(metadata(true))
+                                .build(),
+                        events,
+                        MAIN);
+            else
+                aware.subscribe(
+                        new SubscribeConfig.Builder()
+                                .setServiceName(SERVICE)
+                                .setSubscribeType(SubscribeConfig.SUBSCRIBE_TYPE_ACTIVE)
+                                .setPairingConfig(pairing())
+                                .build(),
+                        events,
+                        MAIN);
+        } catch (RuntimeException e) {
+            fail(e.getMessage());
+        }
+    }
+
+    private final DiscoverySessionCallback events =
+            new DiscoverySessionCallback() {
+                @Override
+                public void onPublishStarted(PublishDiscoverySession s) {
+                    if (closed) {
+                        s.close();
+                        return;
+                    }
+                    discovery = s;
+                    publication.complete(
+                            Arrays.asList("1", SERVICE, instance, String.valueOf(port)));
+                    status = "服务已发布；等待对端配对或连接";
+                    refresh();
+                    // Return to the invitation QR. Show this activity again when a PIN is needed.
+                    if (ui != null) ui.finish();
+                    requestNetwork(null);
+                }
+
+                @Override
+                public void onSubscribeStarted(SubscribeDiscoverySession s) {
+                    android.util.Log.i("SmartConnectNAN", "Subscribe started " + id);
+                    if (closed) {
+                        s.close();
+                        return;
+                    }
+                    discovery = s;
+                    status = expectedAlias == null ? "选择邀请方设备（首次关联）" : "正在自动发现已关联的邀请方";
+                    if (allowInteraction) MAIN.postDelayed(selectionFallback, 1500);
+                    refresh();
+                }
+
+                @Override
+                public void onServiceDiscovered(ServiceDiscoveryInfo d) {
+                    if (closed) return;
+                    PeerHandle p = d.getPeerHandle();
+                    Map<String, String> names = PeerDeviceInfo.parse(d.getServiceSpecificInfo());
+                    String label = names.getOrDefault(
+                                            "pairingName", names.getOrDefault("modelName", "附近设备"))
+                                    + " #"
+                                    + p.hashCode();
+                    String previous = peers.put(p, label);
+                    if (d.getPairedAlias() != null) aliases.put(p, d.getPairedAlias());
+                    if (selected == null && expectedAlias != null && expectedAlias.equals(d.getPairedAlias())) {
+                        android.util.Log.i("SmartConnectNAN", "Automatically matched authenticated pairing alias");
+                        select(p);
+                    }
+                    if (!label.equals(previous)) refresh();
+                }
+
+                @Override
+                public void onBootstrappingSucceeded(PeerHandle p, int method) {
+                    if (closed) return;
+                    if (publisher) {
+                        pin(p);
+                        status = "请在对端输入代码：" + pins.get(p);
+                        if (ui == null || ui.isFinishing()) startUI();
+                        refresh();
+                    } else if (p.equals(selected)) {
+                        if (!allowInteraction) { fail("首次 NAN 配对需要用户输入 PIN"); return; }
+                        needsPin = true;
+                        if (ui == null || ui.isFinishing()) startUI();
+                        else ui.enterPin();
+                    }
+                }
+
+                @Override
+                public void onPairingSetupRequestReceived(PeerHandle p, int request) {
+                    try {
+                        if (publisher) {
+                            Integer accepted = acceptedRequests.get(p);
+                            if (accepted != null) {
+                                if (accepted != request) discovery.rejectPairingRequest(request, p);
+                                return;
+                            }
+                            acceptedRequests.put(p, request);
+                            discovery.acceptPairingRequest(
+                                    request,
+                                    p,
+                                    "smartconnect-" + UUID.randomUUID(),
+                                    Characteristics.WIFI_AWARE_CIPHER_SUITE_NCS_PK_PASN_128,
+                                    pin(p));
+                        } else discovery.rejectPairingRequest(request, p);
+                    } catch (RuntimeException e) {
+                        fail(e.getMessage());
+                    }
+                }
+
+                @Override
+                public void onPairingSetupSucceeded(PeerHandle p, String alias) {
+                    aliases.put(p, alias);
+                    verifiedPeers.add(p);
+                    acceptedRequests.remove(p);
+                    pins.remove(p);
+                    status = "系统配对成功，正在连接";
+                    refresh();
+                    if (!publisher && p.equals(selected)) requestNetwork(p);
+                }
+
+                @Override
+                public void onPairingSetupFailed(PeerHandle p) {
+                    fail("系统配对失败，请核对 PIN");
+                }
+
+                @Override
+                public void onBootstrappingFailed(PeerHandle p) {
+                    fail("配对方式协商失败");
+                }
+
+                @Override
+                public void onPairingVerificationSucceed(PeerHandle p, String alias) {
+                    if (closed) return;
+                    aliases.put(p, alias);
+                    verifiedPeers.add(p);
+                    android.util.Log.i("SmartConnectNAN", "Cached NAN pairing verified");
+                    if (!publisher && p.equals(selected)) requestNetwork(p);
+                }
+
+                @Override
+                public void onPairingVerificationFailed(PeerHandle p) {
+                    if (!publisher && (selected == null || !selected.equals(p))) return;
+                    if (targetIdentity != null) bindings().verificationFailed(targetIdentity);
+                    if (authenticatedIdentity != null) bindings().verificationFailed(authenticatedIdentity);
+                    fail("已有配对验证失败，自动重连已暂停；请重新配对后手动连接");
+                }
+
+                @Override
+                public void onSessionConfigFailed() {
+                    fail("Aware 服务配置失败");
+                }
+
+                @Override
+                public void onSessionTerminated() {
+                    fail("Aware 发现会话结束");
+                }
+            };
+
+    void select(PeerHandle p) {
+        if (closed || selected != null || discovery == null) return;
+        android.util.Log.i("SmartConnectNAN", "Selected peer; paired=" + aliases.containsKey(p));
+        selected = p;
+        MAIN.removeCallbacks(selectionFallback);
+        if (ui != null) ui.finish();
+        try {
+            if (aliases.containsKey(p)) {
+                if (verifiedPeers.contains(p)) requestNetwork(p);
+                else {
+                    status = "正在验证已有 NAN 配对";
+                    android.util.Log.i("SmartConnectNAN", "Waiting for cached NAN pairing verification");
+                }
+            } else bootstrapWithMetadata(p, metadata(false));
+        } catch (RuntimeException e) {
+            fail(e.getMessage());
+        }
+    }
+
+    void submitPin(String pin) {
+        if (closed || selected == null) return;
+        needsPin = false;
+        try {
+            discovery.initiatePairingRequest(
+                    selected,
+                    "smartconnect-" + UUID.randomUUID(),
+                    Characteristics.WIFI_AWARE_CIPHER_SUITE_NCS_PK_PASN_128,
+                    pin);
+        } catch (RuntimeException e) {
+            fail(e.getMessage());
+        }
+    }
+
+    private String pin(PeerHandle p) {
+        String value = pins.get(p);
+        if (value == null) {
+            value = String.format(Locale.ROOT, "%06d", new SecureRandom().nextInt(1000000));
+            pins.put(p, value);
+        }
+        return value;
+    }
+
+    private void requestNetwork(PeerHandle p) {
+        if (closed || callback != null) return;
+        try {
+            WifiAwareNetworkSpecifier spec =
+                    publisher
+                            ? new WifiAwareNetworkSpecifier.Builder(
+                                            (PublishDiscoverySession) discovery)
+                                    .setPskPassphrase(invitationPassphrase())
+                                    .setPort(port)
+                                    .setTransportProtocol(6)
+                                    .build()
+                            : new WifiAwareNetworkSpecifier.Builder(discovery, p).build();
+            callback =
+                    new ConnectivityManager.NetworkCallback() {
+                        @Override
+                        public void onAvailable(Network n) {
+                            network = n;
+                            ready();
+                        }
+
+                        @Override
+                        public void onCapabilitiesChanged(Network n, NetworkCapabilities caps) {
+                            if (caps.getTransportInfo() instanceof WifiAwareNetworkInfo) {
+                                info = (WifiAwareNetworkInfo) caps.getTransportInfo();
+                                ready();
+                            }
+                        }
+
+                        @Override
+                        public void onLinkPropertiesChanged(Network n, LinkProperties props) {
+                            properties = props;
+                            ready();
+                        }
+
+                        @Override
+                        public void onLost(Network n) {
+                            fail("Aware 数据链路已断开");
+                        }
+
+                        @Override
+                        public void onUnavailable() {
+                            fail("Aware 数据链路请求失败");
+                        }
+                    };
+            context.getSystemService(ConnectivityManager.class)
+                    .requestNetwork(
+                            new NetworkRequest.Builder()
+                                    .addTransportType(NetworkCapabilities.TRANSPORT_WIFI_AWARE)
+                                    .setNetworkSpecifier(spec)
+                                    .build(),
+                            callback,
+                            MAIN,
+                            publisher ? 130000 : 30000);
+        } catch (RuntimeException e) {
+            fail(e.getMessage());
+        }
+    }
+
+    private void ready() {
+        if (closed || delivered || network == null || properties == null) return;
+        // A responder may not receive initiator-only peer transport information.
+        // Its existing WSS listener only needs the acquired Network to stay alive.
+        if (!publisher && (info == null || info.getPeerIpv6Addr() == null)) return;
+        delivered = true;
+        MAIN.removeCallbacks(timeout);
+        status = "Aware 数据链路已建立";
+        refresh();
+        if (ui != null) ui.finish();
+        if (targetIdentity != null) RETRY_AFTER.remove(targetIdentity);
+        for (Connection owner : new ArrayList<>(connections)) owner.ready();
+    }
+
+    private String invitationPassphrase() {
+        try {
+            byte[] digest = java.security.MessageDigest.getInstance("SHA-256")
+                    .digest(instance.getBytes(StandardCharsets.UTF_8));
+            return android.util.Base64.encodeToString(digest, android.util.Base64.NO_WRAP);
+        } catch (java.security.NoSuchAlgorithmException e) {
+            throw new IllegalStateException("SHA-256 unavailable", e);
+        }
+    }
+
+    void refresh() {
+        if (ui != null) ui.refresh();
+    }
+
+    void fail(String why) {
+        if (closed) return;
+        android.util.Log.w("SmartConnectNAN", "Session failed: " + why);
+        if (allowInteraction || ui != null) android.widget.Toast.makeText(
+                        context,
+                        why == null ? "Wi-Fi Aware 操作失败" : why,
+                        android.widget.Toast.LENGTH_LONG)
+                .show();
+        publication.complete(null);
+        if (targetIdentity != null) RETRY_AFTER.put(targetIdentity, SystemClock.elapsedRealtime() + 15000);
+        for (Connection owner : new ArrayList<>(connections)) owner.failed(why == null ? "Aware 操作失败" : why);
+        close();
+    }
+
+    @Override
+    public void close() {
+        if (Looper.myLooper() == Looper.getMainLooper()) closeOnMain();
+        else MAIN.post(this::closeOnMain);
+    }
+
+    private void closeOnMain() {
+        if (closed) return;
+        android.util.Log.i("SmartConnectNAN", "Closing session " + id);
+        closed = true;
+        MAIN.removeCallbacks(timeout);
+        MAIN.removeCallbacks(selectionFallback);
+        SUBSCRIBERS.entrySet().removeIf(entry -> entry.getValue() == this);
+        for (Connection owner : connections) owner.closed.set(true);
+        connections.clear();
+        SESSIONS.remove(id);
+        publication.complete(null);
+        if (callback != null) {
+            try {
+                context.getSystemService(ConnectivityManager.class)
+                        .unregisterNetworkCallback(callback);
+            } catch (RuntimeException ignored) {
+            }
+            callback = null;
+        }
+        if (discovery != null) discovery.close();
+        if (aware != null) aware.close();
+        verifiedPeers.clear();
+        pins.clear();
+        acceptedRequests.clear();
+        if (ui != null) ui.finish();
+    }
+
+    // OEM fwk.jar precedes android.jar and still declares API 36. Resolve these
+    // public API 37 additions without falling back to the overload that drops TXT.
+    private void bootstrapWithMetadata(PeerHandle peer, byte[] txt) {
+        try {
+            DiscoverySession.class
+                    .getMethod(
+                            "initiateBootstrappingRequest",
+                            PeerHandle.class,
+                            int.class,
+                            byte[].class)
+                    .invoke(
+                            discovery,
+                            peer,
+                            AwarePairingConfig.PAIRING_BOOTSTRAPPING_PIN_CODE_KEYPAD,
+                            txt);
+        } catch (ReflectiveOperationException e) {
+            throw new IllegalStateException("ROM 不支持 Android 17 Bootstrap 设备信息接口", e);
+        }
+    }
+
+    private byte[] bootstrapTxt(Map<String, String> values) {
+        try {
+            return (byte[])
+                    WifiAwareManager.class
+                            .getMethod("createTxtRecordTlvBuffer", Map.class)
+                            .invoke(null, values);
+        } catch (ReflectiveOperationException e) {
+            throw new IllegalStateException("ROM 不支持 Android 17 配对 TXT 接口", e);
+        }
+    }
+
+    private byte[] metadata(boolean envelope) {
+        Map<String, String> m = new LinkedHashMap<>();
+        m.put("modelName", bounded(Build.MODEL));
+        m.put(
+                "pairingName",
+                bounded(Settings.Global.getString(context.getContentResolver(), "device_name")));
+        m.put("vendorName", bounded(Build.MANUFACTURER));
+        if (!envelope) return bootstrapTxt(m);
+        ByteArrayOutputStream txt = new ByteArrayOutputStream();
+        for (Map.Entry<String, String> e : m.entrySet()) {
+            byte[] b = (e.getKey() + "=" + e.getValue()).getBytes(StandardCharsets.UTF_8);
+            txt.write(b.length);
+            txt.write(b, 0, b.length);
+        }
+        byte[] data = txt.toByteArray();
+        ByteArrayOutputStream out = new ByteArrayOutputStream();
+        out.write(4);
+        out.write(data.length & 255);
+        out.write(data.length >> 8);
+        out.write(data, 0, data.length);
+        return out.toByteArray();
+    }
+
+    private static String bounded(String s) {
+        if (s == null || s.isEmpty()) s = "Android";
+        while (s.getBytes(StandardCharsets.UTF_8).length > 63)
+            s = s.substring(0, s.offsetByCodePoints(s.length(), -1));
+        return s;
+    }
+}
