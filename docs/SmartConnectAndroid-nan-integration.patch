+package com.motorola.smartconnect.connectivity.nan;
+
+import static org.junit.Assert.*;
+
+import org.junit.Test;
+
+import java.util.*;
+
+public class NanPolicyTest {
+    @Test
+    public void acceptsIOSPolicy() {
+        assertEquals(
+                45455,
+                NanPolicy.port(
+                        Arrays.asList("1", "_smartconnect._tcp", "invitation-123", "45455")));
+    }
+
+    @Test
+    public void rejectsMalformedInvitations() {
+        List<List<String>> bad =
+                Arrays.asList(
+                        null,
+                        Collections.emptyList(),
+                        Arrays.asList("2", NanPolicy.SERVICE, "12345678", "1"),
+                        Arrays.asList("1", "_wrong._tcp", "12345678", "1"),
+                        Arrays.asList("1", NanPolicy.SERVICE, null, "1"),
+                        Arrays.asList("1", NanPolicy.SERVICE, "12345678", "0"),
+                        Arrays.asList("1", NanPolicy.SERVICE, "12345678", "65536"));
+        for (List<String> values : bad) {
+            try {
+                NanPolicy.port(values);
+                fail("accepted " + values);
+            } catch (IllegalArgumentException expected) {
+            }
+        }
+    }
+}
