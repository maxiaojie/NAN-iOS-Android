+    // Resolve only an already established SC peer; no fresh discovery or raw-IP dial.
+    func nfsTCP(_ peerIP: String, port: Int, accepting: Bool) async throws -> UInt16 {
+        guard (1...65535).contains(port) else { throw error("Invalid NFS TCP port") }
+        func host(_ value: String) -> String {
+            String(value.trimmingCharacters(in: CharacterSet(charactersIn: "[]")).split(separator: "%")[0]).lowercased()
+        }
+        guard !peerIP.isEmpty,
+              let (parentID, owner) = sessions.first(where: {
+                  $0.value.purpose.isEmpty && !$0.value.remoteIP.isEmpty &&
+                  ($0.value.parent.isEmpty || sessions[$0.value.parent]?.parent == "publisher") &&
+                  host($0.value.remoteIP) == host(peerIP) && $0.value.remote != nil
+              }), let original = owner.remote else { throw error("No established SC NAN peer for NFS") }
+        guard case .ready = original.state else { throw error("SC NAN peer is not ready") }
+        let id = "nfs:\(accepting ? "listen" : "connect"):\(parentID):\(port)"
+        if let existing = sessions[id] {
+            if existing.failure == nil {
+                do { try await wait(existing); return existing.port }
+                catch { close(id); throw error }
+            }
+            close(id)
+        }
+        let s = Session(); s.parent = parentID; s.purpose = "nfs"; sessions[id] = s
+        do {
+            let listener: NetworkListener<TCP>
+            if accepting {
+                guard let path = try await original.currentPath?.wifiAware else { throw error("Missing NFS Aware path") }
+                listener = try NetworkListener(for: .wifiAware(.addingConnections(from: .selected([path.endpoint.device])), active: .seconds(3600)),
+                    using: .parameters { TCP() }.localPort(.any).wifiAware { $0.performanceMode = .bulk })
+            } else {
+                listener = try NetworkListener(using: .parameters { TCP() }.localEndpoint(.hostPort(host: "127.0.0.1", port: .any)))
+            }
+            listener.onStateUpdate { _, state in
+                if case .ready = state { s.port = listener.port?.rawValue ?? 0; s.ready = s.port != 0 }
+                if case .failed(let failure) = state { s.ready = false; s.failure = failure }
+            }
+            s.tasks.append(Task {
+                do {
+                    try await listener.run { accepted in
+                        if accepting {
+                            let local = NetworkConnection(to: .hostPort(host: "127.0.0.1", port: NWEndpoint.Port(rawValue: UInt16(port))!), using: .parameters { TCP() })
+                            self.relayNFS(accepted, local, parent: id)
+                        } else {
+                            guard let endpoint = original.currentPath?.remoteEndpoint ?? original.remoteEndpoint,
+                                  let copied = NWEndpoint(copying: endpoint, newPort: NWEndpoint.Port(rawValue: UInt16(port))!) else {
+                                throw self.error("Cannot preserve NFS Aware endpoint")
+                            }
+                            let remote = NetworkConnection(to: copied, using: .parameters { TCP() }.wifiAware { $0.performanceMode = .bulk })
+                            self.relayNFS(accepted, remote, parent: id)
+                        }
+                    }
+                } catch { s.ready = false; s.failure = error }
+            })
+            try await wait(s)
+            guard sessions[parentID] === owner else { throw error("SC disconnected while preparing NFS") }
+            Self.logger.notice("NAN NFS TCP ready accepting=\(accepting) localPort=\(port) exposedPort=\(s.port)")
+            return s.port
+        } catch { close(id); throw error }
+    }
+    private func relayNFS(_ a: NetworkConnection<TCP>, _ b: NetworkConnection<TCP>, parent: String) {
+        guard sessions[parent] != nil else { return }
+        let id = UUID().uuidString
+        let s = Session(); s.parent = parent; s.purpose = "nfs-flow"; sessions[id] = s
+        s.tasks.append(Task {
+            defer { self.close(id) }
+            do {
+                let firstA = startReading(a, session: s), firstB = startReading(b, session: s)
+                try await waitUntilReady(a); try await waitUntilReady(b)
+                Self.logger.notice("NAN NFS TCP relay ready")
+                try await Self.pipe(a, b, initialA: firstA, initialB: firstB)
+            } catch { Self.logger.error("NAN NFS TCP relay ended: \(String(describing: error), privacy: .public)") }
+        })
+    }
     func close(_ id: String) {
         for child in sessions.keys.filter({ sessions[$0]?.parent == id }) { close(child) }
         guard let s = sessions.removeValue(forKey: id) else { return }
