+// Copyright (c) 2026 Lenovo. All rights reserved.
+// Confidential and Restricted.
+
+// Package nan adapts Apple's Network/WiFiAware transport to the existing WSS core.
+// Native sockets stay on loopback; TLS and the SmartConnect handshake stay in Go.
+package nan
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net"
+	"strconv"
+	"sync"
+)
+
+const Service = "_smartconnect._tcp"
+
+// Policy v1: [version, service name, invitation instance, Aware TCP port].
+// All elements remain strings for Android's existing policies map decoder.
+type Policy struct {
+	Service, Instance string
+	Port              int
+}
+
+func Parse(values []string) (Policy, error) {
+	if len(values) != 4 || values[0] != "1" || values[1] != Service || len(values[2]) < 8 || len(values[2]) > 128 {
+		return Policy{}, errors.New("unsupported NAN policy")
+	}
+	port, err := strconv.Atoi(values[3])
+	if err != nil || port < 1 || port > 65535 {
+		return Policy{}, errors.New("invalid NAN port")
+	}
+	return Policy{values[1], values[2], port}, nil
+}
+func (p Policy) Values() []string { return []string{"1", p.Service, p.Instance, strconv.Itoa(p.Port)} }
+
+// Callback methods run on Go workers, never on UIKit's main thread.
+// Native owns the Aware connection and a bounded-lifetime loopback proxy.
+type Callback interface {
+	Publish(instance string, localPort int) string
+	Connect(deviceID string, policyJSON string, parentRoute string) string
+	Reverse(route string, localPort int) string
+	ResolveIncoming(localPort int) string
+	Close(route string)
+}
+type Route struct {
+	ID       string `json:"id"`
+	Port     int    `json:"port"`
+	LocalIP  string `json:"localIP"`
+	RemoteIP string `json:"remoteIP"`
+}
+
+var mu sync.RWMutex
+var callback Callback
+
+func Init(cb Callback) { mu.Lock(); callback = cb; mu.Unlock() }
+func cb() Callback     { mu.RLock(); defer mu.RUnlock(); return callback }
+func Publish(instance string, port int) []string {
+	c := cb()
+	if c == nil {
+		return nil
+	}
+	var values []string
+	if json.Unmarshal([]byte(c.Publish(instance, port)), &values) != nil {
+		return nil
+	}
+	if _, err := Parse(values); err != nil {
+		return nil
+	}
+	return values
+}
+func Open(deviceID string, values []string, parent string) (Route, error) {
+	if _, err := Parse(values); err != nil {
+		return Route{}, err
+	}
+	c := cb()
+	if c == nil {
+		return Route{}, errors.New("Wi-Fi Aware native transport unavailable")
+	}
+	data, _ := json.Marshal(values)
+	var route Route
+	if json.Unmarshal([]byte(c.Connect(deviceID, string(data), parent)), &route) != nil || route.ID == "" || route.Port < 1 || route.Port > 65535 || !isIPv6(route.LocalIP) || !isIPv6(route.RemoteIP) {
+		if route.ID != "" {
+			c.Close(route.ID)
+		}
+		return Route{}, errors.New("Wi-Fi Aware connection was not established")
+	}
+	return route, nil
+}
+func Reverse(route string, localPort int) ([]string, error) {
+	c := cb()
+	if c == nil {
+		return nil, errors.New("NAN callback unavailable")
+	}
+	var values []string
+	if json.Unmarshal([]byte(c.Reverse(route, localPort)), &values) != nil {
+		return nil, errors.New("NAN reverse listener failed")
+	}
+	if _, err := Parse(values); err != nil {
+		return nil, err
+	}
+	return values, nil
+}
+func Resolve(address string) Route {
+	host, p, err := net.SplitHostPort(address)
+	if err != nil {
+		return Route{}
+	}
+	ip := net.ParseIP(host)
+	if ip == nil || !ip.IsLoopback() {
+		return Route{}
+	}
+	port, _ := strconv.Atoi(p)
+	c := cb()
+	if c == nil {
+		return Route{}
+	}
+	var route Route
+	_ = json.Unmarshal([]byte(c.ResolveIncoming(port)), &route)
+	return route
+}
+func Close(id string) {
+	if id != "" {
+		if c := cb(); c != nil {
+			c.Close(id)
+		}
+	}
+}
+func (r Route) Address() string { return net.JoinHostPort("::1", fmt.Sprint(r.Port)) }
+func isIPv6(address string) bool {
+	host, _, _ := net.SplitHostPort(net.JoinHostPort(address, "1"))
+	for i, c := range host {
+		if c == '%' {
+			host = host[:i]
+			break
+		}
+	}
+	ip := net.ParseIP(host)
+	return ip != nil && ip.To4() == nil && ip.IsLinkLocalUnicast()
+}
