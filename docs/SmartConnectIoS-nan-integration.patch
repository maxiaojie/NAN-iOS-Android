index 00000000..4f6f65ce
--- /dev/null
+++ b/SmartConnect/SCService/SCConnectService/NAN/SCNanTransport.swift
@@ -0,0 +1,417 @@
+// Copyright (c) 2026 Lenovo. All rights reserved.
+import Foundation
+import UIKit
+import SwiftUI
+import Network
+import WiFiAware
+import DeviceDiscoveryUI
+import OSLog
+import Darwin
+
+/// Go only opens loopback sockets. Network framework owns every NAN radio socket.
+@objc(SCNanTransport) final class SCNanTransport: NSObject {
+    @objc static let shared = SCNanTransport()
+    @objc func publish(_ instance: String, localPort: Int) -> String {
+        guard #available(iOS 26.4, *) else { return "" }
+        return call { try await SCNanEngine.shared.publish(instance, localPort: localPort) }
+    }
+    @objc func connect(_ deviceID: String, policyJSON: String, parentRoute: String) -> String {
+        guard #available(iOS 26.4, *) else { return "" }
+        return call(timeout: parentRoute.isEmpty ? 95 : 20) { try await SCNanEngine.shared.connect(policyJSON, parent: parentRoute) }
+    }
+    @objc func reverse(_ route: String, localPort: Int) -> String {
+        guard #available(iOS 26.4, *) else { return "" }
+        return call { try await SCNanEngine.shared.reverse(route, localPort: localPort) }
+    }
+    @objc func resolveIncoming(_ port: Int) -> String {
+        guard #available(iOS 26.4, *) else { return "" }
+        return call { SCNanEngine.shared.incoming[port] ?? "" }
+    }
+    @objc func close(_ route: String) {
+        if #available(iOS 26.4, *) { Task { @MainActor in SCNanEngine.shared.close(route) } }
+    }
+    @objc func showPairing(from controller: UIViewController) {
+        if #available(iOS 26.4, *) {
+            Task { @MainActor in SCNanEngine.shared.showPairing(from: controller) }
+        }
+    }
+    // The generated Go callback is synchronous, and is called from Go workers.
+    // Never wait on UIKit's main thread. Cancellation prevents late UI/listeners.
+    private func call(timeout: Double = 20, _ body: @escaping @MainActor () async throws -> String) -> String {
+        guard #available(iOS 26.4, *), !Thread.isMainThread else { return "" }
+        let box = SCNanResult()
+        let done = DispatchSemaphore(value: 0)
+        let task = Task { @MainActor in
+            defer { done.signal() }
+            do { box.set(try await body()) }
+            catch { SCNanEngine.logger.error("NAN operation failed: \(String(describing: error), privacy: .public)") }
+        }
+        if done.wait(timeout: .now() + timeout) == .timedOut { task.cancel(); return "" }
+        return box.get()
+    }
+}
+private final class SCNanResult: @unchecked Sendable {
+    private let lock = NSLock()
+    private var value = ""
+    func set(_ text: String) { lock.lock(); defer { lock.unlock() }; value = text }
+    func get() -> String { lock.lock(); defer { lock.unlock() }; return value }
+}
+
+@available(iOS 26.4, *)
+@MainActor private final class SCNanEngine {
+    static let shared = SCNanEngine()
+    static let logger = Logger(subsystem: "com.lenovo.smartconnect.ios", category: "NAN")
+    static let service = "_smartconnect._tcp"
+    final class Session {
+        var tasks: [Task<Void, Never>] = []
+        var reads: [Task<Data, Error>] = []
+        var remote: NetworkConnection<TCP>?
+        var ready = false
+        var failure: Error?
+        var port: UInt16 = 0
+        var localIP = ""
+        var remoteIP = ""
+        var parent = ""
+        var generation = UUID()
+        var localPort = 0
+        var consumed = false
+        var incomingPort: Int?
+    }
+    var sessions: [String: Session] = [:]
+    var incoming: [Int: String] = [:]
+    var picker: UIViewController?
+    var pairingActive = false
+    var pairingDelegate: SCNanDismissDelegate?
+    weak var pairingHost: UIViewController?
+    private func error(_ text: String) -> NSError {
+        NSError(domain: "SmartConnect.NAN", code: 1, userInfo: [NSLocalizedDescriptionKey: text])
+    }
+    private func json(_ object: Any) throws -> String {
+        String(decoding: try JSONSerialization.data(withJSONObject: object), as: UTF8.self)
+    }
+    private func policy(_ id: String, port: UInt16) throws -> String {
+        try json(["1", Self.service, id, String(port)])
+    }
+    private func route(_ id: String, _ s: Session) throws -> String {
+        try json(["id": id, "port": Int(s.port), "localIP": s.localIP, "remoteIP": s.remoteIP])
+    }
+    private func wait(_ s: Session, seconds: Int = 15) async throws {
+        for _ in 0..<(seconds * 20) {
+            try Task.checkCancellation()
+            if let failure = s.failure { throw failure }
+            if s.ready { return }
+            try await Task.sleep(for: .milliseconds(50))
+        }
+        throw error("Wi-Fi Aware operation timed out")
+    }
+    private func startReading(_ connection: NetworkConnection<TCP>, session: Session) -> Task<Data, Error> {
+        let task = Task { let (data, _) = try await connection.receive(atMost: 131072); return data }
+        session.reads.append(task)
+        return task
+    }
+    private func waitUntilReady(_ connection: NetworkConnection<TCP>) async throws {
+        // A pending receive starts TCP without queuing an empty write ahead of TLS.
+        for _ in 0..<300 {
+            try Task.checkCancellation()
+            switch connection.state {
+            case .ready: return
+            case .failed(let failure): throw failure
+            case .cancelled: throw CancellationError()
+            default: break
+            }
+            try await Task.sleep(for: .milliseconds(50))
+        }
+        throw error("NAN TCP connection did not become ready")
+    }
+    private func ip(_ connection: NetworkConnection<TCP>, local: Bool) throws -> String {
+        let candidates = local
+            ? [connection.currentPath?.localEndpoint, connection.localEndpoint]
+            : [connection.currentPath?.remoteEndpoint, connection.remoteEndpoint]
+        for endpoint in candidates {
+            if case let .hostPort(host, _) = endpoint { return String(describing: host) }
+            if case let .opaque(raw) = endpoint {
+                let candidate: UnsafePointer<sockaddr>? = nw_endpoint_get_address(raw)
+                guard let address = candidate, address.pointee.sa_family == AF_INET6 else { continue }
+                var host = [CChar](repeating: 0, count: Int(NI_MAXHOST))
+                if getnameinfo(address, socklen_t(address.pointee.sa_len), &host, socklen_t(host.count), nil, 0, NI_NUMERICHOST) == 0 {
+                    return String(cString: host)
+                }
+            }
+
+        }
+        throw error("Missing connected Aware IPv6 endpoint (local=\(local))")
+    }
+    private func startPublisher(_ id: String, session s: Session, port: UInt16 = 0) throws {
+        guard let service = WAPublishableService.allServices[Self.service] else { throw error("NAN publish service not declared") }
+        s.generation = UUID(); let generation = s.generation
+        s.failure = nil; s.ready = false
+        Self.logger.notice("NAN publisher preparing")
+        let listener = try NetworkListener(for: .wifiAware(.connecting(to: service, from: .allPairedDevices), active: .seconds(3600)),
+            using: .parameters { TCP() }.localPort(NWEndpoint.Port(rawValue: port)!))
+        listener.onStateUpdate { _, state in
+            guard s.generation == generation else { return }
+            Self.logger.notice("NAN publisher state=\(String(describing: state), privacy: .public)")
+            if case .ready = state { s.port = listener.port?.rawValue ?? 0; s.ready = s.port != 0 }
+            if case .failed(let e) = state { s.failure = e }
+        }
+        s.tasks.append(Task {
+            Self.logger.notice("NAN publisher run started")
+            do { try await listener.run { remote in self.accept(remote, localPort: s.localPort, parent: id) } }
+            catch { if s.generation == generation { s.failure = error } }
+        })
+    }
+    func publish(_ id: String, localPort: Int) async throws -> String {
+        // Apple permits one publisher per service. Never advertise a port before ready.
+        guard !pairingActive else { return "" }
+        for (oldID, old) in sessions.filter({ $0.value.parent == "publisher" }) {
+            if oldID == id && old.localPort == localPort && old.ready {
+                return try policy(oldID, port: old.port)
+            }
+            // A new QR invitation supersedes an unused BLE invitation. Never
+            // interrupt an accepted data connection to replace its publisher.
+            guard !sessions.values.contains(where: { $0.parent == oldID }) else { return "" }
+            close(oldID)
+        }
+        let s = Session(); s.parent = "publisher"; s.localPort = localPort; sessions[id] = s
+        do {
+            try startPublisher(id, session: s)
+            try await wait(s)
+            Self.logger.notice("NAN publisher ready, port=\(s.port)")
+            return try policy(id, port: s.port)
+        } catch { close(id); throw error }
+    }
+    private func accept(_ remote: NetworkConnection<TCP>, localPort: Int, parent: String) {
+        let id = UUID().uuidString
+        let s = Session(); s.parent = parent; s.remote = remote; sessions[id] = s
+        // Keep accepted connections independent of discovery expiry.
+        s.tasks.append(Task {
+            do {
+                let local = NetworkConnection(to: .hostPort(host: "::1", port: NWEndpoint.Port(rawValue: UInt16(localPort))!), using: .parameters { TCP() })
+                // Establish loopback before forwarding TLS, so Go can resolve this
+                // ephemeral port to the real Aware peer during its HTTP upgrade.
+                let firstLocal = startReading(local, session: s)
+                let firstRemote = startReading(remote, session: s)
+                try await self.waitUntilReady(local)
+                try await self.waitUntilReady(remote)
+                guard case let .hostPort(_, port) = local.localEndpoint else { throw self.error("Missing loopback endpoint") }
+                s.localIP = try self.ip(remote, local: true)
+                s.remoteIP = try self.ip(remote, local: false)
+                s.incomingPort = Int(port.rawValue)
+                self.incoming[Int(port.rawValue)] = try self.route(id, s)
+                Self.logger.notice("Accepted NAN transport")
+                try await Self.pipe(local, remote, initialA: firstLocal, initialB: firstRemote)
+            } catch { Self.logger.error("NAN accepted transport ended: \(String(describing: error), privacy: .public)") }
+            self.close(id)
+        })
+    }
+    func connect(_ text: String, parent: String) async throws -> String {
+        guard let values = try JSONSerialization.jsonObject(with: Data(text.utf8)) as? [String],
+              values.count == 4, values[0] == "1", values[1] == Self.service,
+              let port = UInt16(values[3]), port > 0 else { throw error("Invalid NAN policy") }
+        let id = UUID().uuidString
+        let s = Session(); s.parent = parent; sessions[id] = s
+        do {
+            let remote: NetworkConnection<TCP>
+            if !parent.isEmpty {
+                guard let original = sessions[parent]?.remote, let address = original.currentPath?.remoteEndpoint ?? original.remoteEndpoint else { throw error("NAN parent connection no longer exists") }
+                // Preserve the scoped, Network-owned Aware endpoint; never dial a
+                // raw link-local IP through BSD sockets.
+                guard let copied = NWEndpoint(copying: address, newPort: NWEndpoint.Port(rawValue: port)!) else { throw error("Cannot copy Aware endpoint") }
+                remote = NetworkConnection(to: copied, using: .parameters { TCP() })
+            } else {
+                let endpoint = try await pickDevice()
+                let resolved = try await discover(endpoint.device, port: port)
+                remote = NetworkConnection(to: resolved, using: .parameters { TCP() })
+            }
+            s.remote = remote
+            let firstRemote = startReading(remote, session: s)
+            try await self.waitUntilReady(remote) // Wait for actual NDP/TCP readiness, not just discovery.
+            s.localIP = try ip(remote, local: true); s.remoteIP = try ip(remote, local: false)
+            let listener = try NetworkListener(using: .parameters { TCP() }.localEndpoint(.hostPort(host: "::1", port: .any)))
+            listener.onStateUpdate { _, state in
+                if case .ready = state { s.port = listener.port?.rawValue ?? 0; s.ready = s.port != 0 }
+                if case .failed(let e) = state { s.failure = e }
+            }
+            s.tasks.append(Task {
+                do {
+                    try await listener.run { local in
+                        guard !s.consumed else { return }; s.consumed = true
+                        Self.logger.notice("NAN loopback WSS client accepted")
+                        do { try await Self.pipe(local, remote, initialB: firstRemote) }
+                        catch { Self.logger.error("NAN WSS proxy ended: \(String(describing: error), privacy: .public)") }
+                        self.close(id)
+                    }
+                } catch { s.failure = error }
+            })
+            try await wait(s)
+            // Reclaim an abandoned proxy if the Go dial was cancelled.
+            s.tasks.append(Task {
+                try? await Task.sleep(for: .seconds(30))
+                if !Task.isCancelled && !s.consumed { self.close(id) }
+            })
+            Self.logger.notice("NAN ready before WSS, local proxy port=\(s.port)")
+            return try route(id, s)
+        } catch { close(id); throw error }
+    }
+    private func discover(_ device: WAPairedDevice, port: UInt16) async throws -> WAEndpoint {
+        guard let service = WASubscribableService.allServices[Self.service] else { throw error("NAN service not declared") }
+        let browser = NetworkBrowser(for: .wifiAware(.connecting(to: .selected([device]), from: service)))
+        return try await withThrowingTaskGroup(of: WAEndpoint.self) { group in
+            group.addTask {
+                try await browser.run { endpoints in
+                    if let endpoint = endpoints.first(where: { $0.device.id == device.id }) {
+                        return .finish(endpoint)
+                    }
+                    return .continue
+                }
+            }
+            group.addTask {
+                try await Task.sleep(for: .seconds(15))
+                throw NSError(domain: "SmartConnect.NAN", code: 1,
+                              userInfo: [NSLocalizedDescriptionKey: "Selected NAN service was not discovered"])
+            }
+            defer { group.cancelAll() }
+            guard let endpoint = try await group.next() else { throw error("NAN browser ended") }
+            Self.logger.notice("Selected NAN service discovered, invitation port=\(port)")
+            return endpoint
+        }
+    }
+
+    func reverse(_ id: String, localPort: Int) async throws -> String {
+        guard let remote = sessions[id]?.remote, let path = try await remote.currentPath?.wifiAware else { throw error("NAN reverse verification requires a live connection") }
+        let child = UUID().uuidString
+        let s = Session(); s.parent = id; sessions[child] = s
+        do {
+            let listener = try NetworkListener(for: .wifiAware(.addingConnections(from: .selected([path.endpoint.device])), active: .seconds(3600)),
+                using: .parameters { TCP() }.localPort(.any))
+            listener.onStateUpdate { _, state in
+                if case .ready = state { s.port = listener.port?.rawValue ?? 0; s.ready = s.port != 0 }
+                if case .failed(let e) = state { s.failure = e }
+            }
+            s.tasks.append(Task {
+                do { try await listener.run { remote in self.accept(remote, localPort: localPort, parent: child) } }
+                catch { s.failure = error }
+            })
+            try await wait(s)
+            return try policy(child, port: s.port)
+        } catch { close(child); throw error }
+    }
+    func close(_ id: String) {
+        for child in sessions.keys.filter({ sessions[$0]?.parent == id }) { close(child) }
+        guard let s = sessions.removeValue(forKey: id) else { return }
+        if let port = s.incomingPort { incoming.removeValue(forKey: port) }
+        s.tasks.forEach { $0.cancel() }; s.tasks.removeAll()
+        s.reads.forEach { $0.cancel() }; s.reads.removeAll(); s.remote = nil
+    }
+    private static func pipe(_ a: NetworkConnection<TCP>, _ b: NetworkConnection<TCP>,
+                             initialA: Task<Data, Error>? = nil, initialB: Task<Data, Error>? = nil) async throws {
+        try await withThrowingTaskGroup(of: Void.self) { group in
+            for (index, item) in [(a,b,initialA),(b,a,initialB)].enumerated() {
+                let (source, destination, initial) = item
+                group.addTask {
+                    var pending = initial
+                    var first = true
+                    while !Task.isCancelled {
+                        let data: Data
+                        if let read = pending { data = try await read.value; pending = nil }
+                        else { (data, _) = try await source.receive(atMost: 131072) }
+                        if data.isEmpty { try await destination.send(Data(), endOfStream: true); return }
+                        if first { logger.debug("NAN proxy direction=\(index), first chunk bytes=\(data.count)"); first = false }
+                        try await destination.send(data)
+                    }
+                }
+            }
+            defer { group.cancelAll() }
+            try await group.next()
+        }
+    }
+    private func presentingController() throws -> UIViewController {
+        guard let scene = UIApplication.shared.connectedScenes.compactMap({ $0 as? UIWindowScene }).first(where: { $0.activationState == .foregroundActive }),
+              var controller = scene.windows.first(where: \.isKeyWindow)?.rootViewController else { throw error("NAN device selection requires foreground UI") }
+        while let next = controller.presentedViewController { controller = next }
+        return controller
+    }
+    private func pickDevice() async throws -> WAEndpoint {
+        guard picker == nil, let service = WASubscribableService.allServices[Self.service] else { throw error("NAN device picker unavailable or busy") }
+        let presenter = try presentingController()
+        let selection = SCNanSelection()
+        let view = SCNanPicker(service: service, selection: selection)
+        let controller = UIHostingController(rootView: view)
+        picker = controller; presenter.present(controller, animated: true)
+        controller.presentationController?.delegate = selection
+        defer { controller.dismiss(animated: true); picker = nil }
+        for _ in 0..<1600 {
+            try Task.checkCancellation()
+            if let endpoint = selection.endpoint { return endpoint }
+            if selection.cancelled { throw error("NAN selection cancelled") }
+            try await Task.sleep(for: .milliseconds(50))
+        }
+        throw error("NAN device selection timed out")
+    }
+    func showPairing(from controller: UIViewController) {
+        guard !pairingActive, let service = WAPublishableService.allServices[Self.service] else { return }
+        pairingActive = true
+        // DevicePairingView owns the service advertisement while its UI is open.
+        // Pause only publishers; existing accepted data connections remain alive.
+        let paused = sessions.filter { $0.value.parent == "publisher" }
+        for (_, s) in paused {
+            s.generation = UUID()
+            s.tasks.forEach { $0.cancel() }; s.tasks.removeAll(); s.ready = false
+        }
+        let finish: () -> Void = { [weak self] in
+            guard let self, self.pairingActive else { return }
+            self.pairingActive = false; self.pairingDelegate = nil; self.pairingHost = nil
+            for (id, s) in paused where self.sessions[id] === s {
+                do { try self.startPublisher(id, session: s, port: s.port) }
+                catch { Self.logger.error("NAN publisher resume failed: \(String(describing: error), privacy: .public)") }
+            }
+        }
+        let host = UIHostingController(rootView: SCNanPairing(service: service, finish: { [weak self] in
+            self?.pairingHost?.dismiss(animated: true, completion: finish)
+        }))
+        pairingHost = host
+        let delegate = SCNanDismissDelegate(finish)
+        pairingDelegate = delegate
+        controller.present(host, animated: true)
+        host.presentationController?.delegate = delegate
+    }
+
+}
+@available(iOS 26.4, *) @MainActor private final class SCNanSelection: NSObject, UIAdaptivePresentationControllerDelegate {
+    var endpoint: WAEndpoint?
+    var cancelled = false
+    func presentationControllerDidDismiss(_ presentationController: UIPresentationController) { cancelled = true }
+}
+@available(iOS 26.4, *) private struct SCNanPicker: View {
+    let service: WASubscribableService
+    let selection: SCNanSelection
+    var body: some View {
+        NavigationStack {
+            VStack(spacing: 24) {
+                Text("选择邀请方的 Wi-Fi Aware 设备，完成系统配对后继续连接。")
+                DevicePicker(.wifiAware(.connecting(to: .userSpecifiedDevices, from: service))) { selection.endpoint = $0 } label: {
+                    Label("选择附近设备", systemImage: "wifi")
+                } fallback: { Text("当前设备不支持 Wi-Fi Aware") }
+            }.padding().navigationTitle("Wi-Fi Aware")
+                .toolbar { Button("取消") { selection.cancelled = true } }
+        }
+    }
+}
+@available(iOS 26.4, *) private struct SCNanPairing: View {
+    let service: WAPublishableService
+    let finish: () -> Void
+    var body: some View {
+        NavigationStack {
+            DevicePairingView(.wifiAware(.connecting(to: service, from: .userSpecifiedDevices))) {
+                Label("允许附近设备配对", systemImage: "wifi")
+            } fallback: { Text("当前设备不支持 Wi-Fi Aware") }
+            .navigationTitle("Wi-Fi Aware 配对").toolbar { Button("完成") { finish() } }
+        }
+    }
+}
+
+@available(iOS 26.4, *) @MainActor private final class SCNanDismissDelegate: NSObject, UIAdaptivePresentationControllerDelegate {
+    let finish: () -> Void
+    init(_ finish: @escaping () -> Void) { self.finish = finish }
+    func presentationControllerDidDismiss(_ presentationController: UIPresentationController) { finish() }
+}
