+// Copyright (c) 2026 Lenovo. All rights reserved.
+#import "SCNanCallback.h"
+#import <SCAPI/SCAPI.h>
+#import "SmartConnect-Swift.h"
+@interface SCNanCallback () <IOSNanAPICallback>
+@end
+@implementation SCNanCallback
++ (void)install {
+    static SCNanCallback *callback;
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        callback = [SCNanCallback new];
+        IOSSCAPI_InitNanCallback(callback);
+    });
+}
+- (NSString *)publish:(NSString *)instance localPort:(long)localPort {
+    return [SCNanTransport.shared publish:instance localPort:localPort];
+}
+- (NSString *)connect:(NSString *)deviceID policyJSON:(NSString *)policyJSON parentRoute:(NSString *)parentRoute {
+    return [SCNanTransport.shared connect:deviceID policyJSON:policyJSON parentRoute:parentRoute];
+}
+- (NSString *)reverse:(NSString *)route localPort:(long)localPort {
+    return [SCNanTransport.shared reverse:route localPort:localPort];
+}
+- (NSString *)resolveIncoming:(long)port {
+    return [SCNanTransport.shared resolveIncoming:port];
+}
+- (void)close:(NSString *)route { [SCNanTransport.shared close:route]; }
+@end
diff --git a/SmartConnect/SCService/SCConnectService/NAN/SCNanTransport.swift b/SmartConnect/SCService/SCConnectService/NAN/SCNanTransport.swift
