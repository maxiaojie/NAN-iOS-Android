+// Copyright (c) 2026 Lenovo. All rights reserved.
+// Confidential and Restricted.
+
+package nan
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestPolicyWireCompatibility(t *testing.T) {
+	valid := []string{"1", Service, "invite-123456", "45455"}
+	p, err := Parse(valid)
+	if err != nil || p.Port != 45455 {
+		t.Fatal(p, err)
+	}
+	data, _ := json.Marshal([]map[string][]string{{"wifi": {"192.0.2.1"}}, {"nan": p.Values()}})
+	var legacy []map[string][]string
+	if json.Unmarshal(data, &legacy) != nil || legacy[0]["wifi"][0] != "192.0.2.1" {
+		t.Fatal(string(data))
+	}
+	for _, bad := range [][]string{nil, {"1", Service, "invite-123456"}, {"2", Service, "invite-123456", "1"}, {"1", "_wrong._tcp", "invite-123456", "1"}, {"1", Service, "invite-123456", "0"}, {"1", Service, "invite-123456", "65536"}} {
+		if _, err := Parse(bad); err == nil {
+			t.Fatal("accepted", bad)
+		}
+	}
+}
+func TestNoCallbackDoesNotClaimReady(t *testing.T) {
+	Init(nil)
+	if Publish("instance-1234", 1234) != nil {
+		t.Fatal("advertised unavailable NAN")
+	}
+	if _, err := Open("peer", []string{"1", Service, "instance-1234", "1234"}, ""); err == nil {
+		t.Fatal("connected without native transport")
+	}
+}
+func TestScopeValidation(t *testing.T) {
+	for _, s := range []string{"fe80::1%nan0", "fe80::2"} {
+		if !isIPv6(s) {
+			t.Fatal(s)
+		}
+	}
+	for _, s := range []string{"::1", "127.0.0.1", "192.0.2.1", ""} {
+		if isIPv6(s) {
+			t.Fatal(s)
+		}
+	}
+}
+
+type fakeNative struct {
+	response string
+	calls    []string
+}
+
+func (f *fakeNative) Publish(string, int) string {
+	f.calls = append(f.calls, "publish")
+	return f.response
+}
+func (f *fakeNative) Connect(deviceID, policy, parent string) string {
+	f.calls = append(f.calls, "connect:"+deviceID+":"+parent)
+	return f.response
+}
+func (f *fakeNative) Reverse(string, int) string { return f.response }
+func (f *fakeNative) ResolveIncoming(int) string {
+	f.calls = append(f.calls, "resolve")
+	return f.response
+}
+func (f *fakeNative) Close(id string) { f.calls = append(f.calls, "close:"+id) }
+
+func TestOpenOnlyAcceptsEstablishedAwareRoute(t *testing.T) {
+	f := &fakeNative{}
+	Init(f)
+	t.Cleanup(func() { Init(nil) })
+	values := []string{"1", Service, "invitation-123", "5555"}
+	// A callback that supplies loopback/STA rather than the Aware IPv6 path
+	// must not cause WSS to run or leak the native route.
+	f.response = `{"id":"bad","port":4321,"localIP":"::1","remoteIP":"192.0.2.1"}`
+	if _, err := Open("device", values, ""); err == nil {
+		t.Fatal("accepted non-Aware route")
+	}
+	if len(f.calls) != 2 || f.calls[1] != "close:bad" {
+		t.Fatal(f.calls)
+	}
+	f.response = `{"id":"ready","port":4321,"localIP":"fe80::1%nan0","remoteIP":"fe80::2%nan0"}`
+	route, err := Open("device", values, "parent")
+	if err != nil || route.Address() != "[::1]:4321" || f.calls[2] != "connect:device:parent" {
+		t.Fatal(route, err, f.calls)
+	}
+	Close(route.ID)
+	if f.calls[3] != "close:ready" {
+		t.Fatal(f.calls)
+	}
+}
+func TestMalformedPolicyNeverReachesNative(t *testing.T) {
+	f := &fakeNative{}
+	Init(f)
+	t.Cleanup(func() { Init(nil) })
+	if _, err := Open("device", []string{"1", Service, "12345678", "99999"}, ""); err == nil {
+		t.Fatal("accepted invalid port")
+	}
+	if len(f.calls) != 0 {
+		t.Fatal(f.calls)
+	}
+}
+func TestPublishRequiresValidNativeListenerPolicy(t *testing.T) {
+	f := &fakeNative{response: `["1","_smartconnect._tcp","invitation-123","0"]`}
+	Init(f)
+	t.Cleanup(func() { Init(nil) })
+	if Publish("invitation-123", 1234) != nil {
+		t.Fatal("advertised listener without bound port")
+	}
+	f.response = `["1","_smartconnect._tcp","invitation-123","4321"]`
+	if p := Publish("invitation-123", 1234); len(p) != 4 || p[3] != "4321" {
+		t.Fatal(p)
+	}
+}
+
+func TestIncomingRouteResolutionIsLoopbackOnly(t *testing.T) {
+	f := &fakeNative{response: `{"id":"incoming","localIP":"fe80::1","remoteIP":"fe80::2"}`}
+	Init(f)
+	t.Cleanup(func() { Init(nil) })
+	for _, addr := range []string{"192.0.2.1:1234", "[fe80::1]:1234", "invalid"} {
+		if Resolve(addr).ID != "" {
+			t.Fatal("resolved external connection", addr)
+		}
+	}
+	if len(f.calls) != 0 {
+		t.Fatal(f.calls)
+	}
+	if Resolve("[::1]:1234").ID != "incoming" {
+		t.Fatal("missing loopback mapping")
+	}
+}
